# Copy to .env (never commit .env). On Windows the preferred store is
# Credential Manager via `mmm auth set-keys`; .env is the fallback.
MMM_KITE_API_KEY=your_api_key
MMM_KITE_API_SECRET=your_api_secret
# Redirect URL registered in the Kite developer console:
MMM_KITE_REDIRECT_URL=http://127.0.0.1:5010/callback
# Where market data lives (defaults to ./data). Put it on a second drive on Windows, e.g. D:\ShareMarketData
MMM_DATA_DIR=./data
# Optional Telegram alerts
MMM_TELEGRAM_BOT_TOKEN=
MMM_TELEGRAM_CHAT_ID=
